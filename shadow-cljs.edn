{:source-paths ["src" "test"]

 :builds
 {:app
  {:target :browser
   :output-dir "public/js"
   :asset-path "js"
   :modules
   {:main
    {:entries [app.main]}}}

  :test
  {:target :node-test
   :output-to "target/node-tests.js"
   :ns-regexp "-test$"
   :autorun true
   :js-options {:js-provider :require}}}}
